rules_version = '2';

// Parental-control backend rules.
// Identity model:
//   * Parent  = signed-in, NON-anonymous Firebase user (Google / email). uid = family id.
//   * Child   = ANONYMOUS Firebase user created on the child phone. uid = device id.
// Only the parent may write policy. Only the child may write status/usage/audit.
// A child joins a family only by claiming an unexpired, unclaimed pairing token in ONE batch
// that also creates its device document.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function provider() { return request.auth.token.firebase.sign_in_provider; }
    function isParent(pid) { return signedIn() && request.auth.uid == pid && provider() != 'anonymous'; }
    function isChild(cid)  { return signedIn() && request.auth.uid == cid && provider() == 'anonymous'; }
    // A child only counts while its device doc exists; unlinking deletes it and cuts access.
    function linkedChild(pid, cid) {
      return isChild(cid)
        && exists(/databases/$(database)/documents/families/$(pid)/devices/$(cid));
    }

    // ---- Pairing tokens -------------------------------------------------------------
    // Token = 128-bit random doc id carried in the QR. Knowing the id is the capability,
    // so `list` is denied (no enumeration) and ids must be long.
    match /pairings/{token} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if token.size() >= 32
        && isParent(request.resource.data.parentUid)
        && request.resource.data.keys().hasOnly(['parentUid', 'status', 'expiresAt', 'createdAt'])
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(30, 'm');

      // Child claims it (open -> claimed, claimedBy = its own uid). One shot.
      allow update: if signedIn() && provider() == 'anonymous'
        && resource.data.status == 'open'
        && resource.data.expiresAt > request.time
        && request.resource.data.status == 'claimed'
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedBy']);

      allow delete: if isParent(resource.data.parentUid);
    }

    // ---- Family ---------------------------------------------------------------------
    match /families/{pid} {
      allow read: if isParent(pid);
      allow create: if isParent(pid) && request.resource.data.keys().hasOnly(['createdAt']);

      match /devices/{cid} {
        allow read: if isParent(pid) || isChild(cid);

        // Created by the child in the same batch that claims the token.
        allow create: if isChild(cid)
          && request.resource.data.keys().hasOnly(['deviceName', 'platform', 'appVersion', 'pairedAt', 'pairingToken'])
          && request.resource.data.pairedAt == request.time
          // Pre-write state: the token must still be OPEN and unexpired. Without this, a child that was
          // unlinked could re-create its device doc with its already-claimed token.
          && get(/databases/$(database)/documents/pairings/$(request.resource.data.pairingToken)).data.status == 'open'
          && get(/databases/$(database)/documents/pairings/$(request.resource.data.pairingToken)).data.expiresAt > request.time
          // Post-write state: the same batch must claim it for THIS child and THIS parent.
          // Immutable fields (parentUid/expiry) remain present after the claim.
          && getAfter(/databases/$(database)/documents/pairings/$(request.resource.data.pairingToken)).data.status == 'claimed'
          && getAfter(/databases/$(database)/documents/pairings/$(request.resource.data.pairingToken)).data.claimedBy == cid
          && getAfter(/databases/$(database)/documents/pairings/$(request.resource.data.pairingToken)).data.expiresAt > request.time
          && getAfter(/databases/$(database)/documents/pairings/$(request.resource.data.pairingToken)).data.parentUid == pid;

        allow update: if (isParent(pid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceName']))
          || (isChild(cid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['appVersion']));

        // Parent unlinks. The child then gets permission-denied on read and must de-enroll.
        allow delete: if isParent(pid);

        // Policy: parent-only writes, strictly monotonic version.
        match /policy/{name} {
          allow read: if isParent(pid) || linkedChild(pid, cid);

          allow create: if isParent(pid) && name == 'current'
            && exists(/databases/$(database)/documents/families/$(pid)/devices/$(cid))
            && request.resource.data.version == 1
            && request.resource.data.keys().hasOnly(['version', 'updatedAt', 'apps', 'schedules', 'controls'])
            && request.resource.data.controls is map
            && request.resource.data.apps.size() <= 500
            && request.resource.data.schedules.size() <= 50;

          allow update: if isParent(pid) && name == 'current'
            && request.resource.data.version == resource.data.version + 1
            && request.resource.data.keys().hasOnly(['version', 'updatedAt', 'apps', 'schedules', 'controls'])
            && request.resource.data.controls is map
            && request.resource.data.apps.size() <= 500
            && request.resource.data.schedules.size() <= 50;
        }

        // Child -> parent status. lastSeen must be the server time (not client-forged).
        match /status/{name} {
          allow read: if isParent(pid) || linkedChild(pid, cid);
          allow create, update: if linkedChild(pid, cid) && name == 'heartbeat'
            && request.resource.data.keys().hasOnly(
                 ['lastSeen', 'ackedPolicyVersion', 'isDeviceOwner', 'accessibilityEnabled', 'appVersion'])
            && request.resource.data.lastSeen == request.time;
        }

        // Installed-app inventory reported by the child so the parent can build rules for real apps.
        match /inventory/{name} {
          allow read: if isParent(pid) || linkedChild(pid, cid);
          allow create, update: if linkedChild(pid, cid) && name == 'current'
            && request.resource.data.keys().hasOnly(['apps', 'updatedAt'])
            && request.resource.data.apps is list
            && request.resource.data.apps.size() <= 500
            && request.resource.data.updatedAt == request.time;
        }

        // Daily usage written by the child, read by the parent.
        match /usage/{day} {
          allow read: if isParent(pid) || linkedChild(pid, cid);
          allow create, update: if linkedChild(pid, cid)
            && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && request.resource.data.keys().hasOnly(['minutesByPackage', 'updatedAt'])
            && request.resource.data.updatedAt == request.time;
        }

        // Append-only audit trail from the child.
        match /audit/{id} {
          allow read: if isParent(pid);
          allow create: if linkedChild(pid, cid)
            && request.resource.data.keys().hasOnly(['event', 'details', 'createdAt'])
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
